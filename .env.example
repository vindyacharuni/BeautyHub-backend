# MongoDB Connection String (Atlas Cluster or Local Instance)
MONGO_URL=mongodb://localhost:27017/beautyhub

# JWT Signing Secrets (Replace with long, cryptographically secure random keys)
JWT_SECRET=your_legacy_jwt_secret_key
ACCESS_TOKEN_SECRET=your_access_token_secret_key_15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_7d

# Redis In-Memory Database URL
REDIS_URL=redis://127.0.0.1:6379

# Environment Mode (development / production)
NODE_ENV=development

# SMTP Email Verification Credentials (Optional)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
